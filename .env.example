# Copy to .env.local for development. Never commit real values.

# Clerk (publishable key is public by design; the secret key is server-only)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/profile/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/profile/sign-up

# The Go API, reached only from the server-side /api proxy. Never NEXT_PUBLIC_.
API_INTERNAL_URL=http://localhost:8080
PROXY_SHARED_SECRET=

# Public origin of this app, used for registration links and QR codes
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to 1 to answer /api calls in the browser from MSW mocks built on the contract
NEXT_PUBLIC_API_MOCKS=0
