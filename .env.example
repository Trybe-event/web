# Trybe web (Next.js) environment template.
# Copy to .env.local and fill in. Never commit real secrets.
# Only NEXT_PUBLIC_ values are exposed to the browser (PRD section 38).

# Base URL of the private Go core API. The same-origin /api proxy forwards here.
# Server-only; not exposed to the browser.
API_BASE_URL=http://127.0.0.1:8080

# Public, safe to expose (SDK requires a public identifier):
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Server-only secret, never sent to the browser:
CLERK_SECRET_KEY=
# Each auth component defines its own organizer/attendee routes explicitly.
